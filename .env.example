# Copy to .env for local dev (node dev-server.js). On Vercel add the same names in Settings -> Environment Variables.
# NEVER commit real values. All of these are read ONLY on the server.

# --- sign-in & storage ---
GOOGLE_CLIENT_ID=
SESSION_SECRET=            # >= 32 random characters
KV_REST_API_URL=           # Upstash Redis (Vercel Marketplace)
KV_REST_API_TOKEN=

# --- Apple WeatherKit ---
APPLE_TEAM_ID=
APPLE_SERVICE_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=         # contents of the .p8 file, newlines as \n

# Driply: ники с синей галочкой через запятую (например kk1cher9)
VERIFIED_NICKS=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
BANNED_NICKS=
# sub аккаунта @kk1cher9: видит точное время последней активности других (Настройки → Скопировать ID аккаунта)
ACTIVITY_ADMIN_USER_ID=
# необязательно: поиск GIF в редакторе фото (бесплатный ключ на developers.giphy.com). Без ключа можно загружать свои GIF (до 260 КБ).
GIPHY_API_KEY=
